10 REM LOGIC GARDEN 110: THE ARTIST
20 PRINT CHR$(147) : REM CLEAR SCREEN
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK BORDER/BG

40 REM --- DEFINE QUADRANTS ---
50 REM Q1: 0-19, 0-12. Q2: 20-39, 0-12...
60 REM DRAW STATIC FACES IN ALL 4 QUADS
70 FOR Q = 0 TO 3
80   QX = (Q AND 1) * 20
90   QY = INT(Q/2) * 12
100  GOSUB 1000 : REM DRAW_FACE SUBROUTINE
110 NEXT Q

200 REM --- ANIMATION LOOP ---
210 FOR T = 0 TO 50 : REM TIME DELAY
220 NEXT T

300 REM --- THE TURN (EYE SWAP) ---
310 REM SWAP CHARACTERS FOR EYES FROM 'SIDE' (CIRCLE) TO 'FRONT' (DOTS)
320 FOR Q = 0 TO 3
330   QX = (Q AND 1) * 20
340   QY = INT(Q/2) * 12
350   REM EYES POS: QX+8, QY+5
360   ADDR = 1024 + (QY+5)*40 + QX + 8
370   POKE ADDR, 81 : REM LEFT EYE (FILLED BALL)
380   POKE ADDR+3, 81 : REM RIGHT EYE
390 NEXT Q

400 REM --- COLOR CYCLE FLASH ---
410 C1=1 : C2=7 : C3=5 : C4=2
420 FOR F = 1 TO 100
430   REM ROTATE COLORS
440   TMP=C4 : C4=C3 : C3=C2 : C2=C1 : C1=TMP
450   REM PAINT Q1
460   COL = C1 : QX=0 : QY=0 : GOSUB 2000
470   REM PAINT Q2
480   COL = C2 : QX=20 : QY=0 : GOSUB 2000
490   REM PAINT Q3
500   COL = C3 : QX=0 : QY=12 : GOSUB 2000
510   REM PAINT Q4
520   COL = C4 : QX=20 : QY=12 : GOSUB 2000
530 NEXT F
540 GOTO 410

1000 REM --- DRAW FACE SUBROUTINE (AT QX, QY) ---
1010 REM SIMPLIFIED BOX HEAD
1020 FOR Y = 2 TO 10
1030   FOR X = 5 TO 15
1040     POKE 1024 + (QY+Y)*40 + (QX+X), 160 : REM SOLID BLOCK
1050   NEXT X
1060 NEXT Y
1070 REM HAIR
1080 FOR X = 4 TO 16
1090   POKE 1024 + (QY+1)*40 + (QX+X), 177 : REM CHECKERBOARD
1100 NEXT X
1110 REM SIDE EYES (INITIAL)
1120 POKE 1024 + (QY+5)*40 + (QX+8), 87 : REM CIRCLE (LOOKING LEFT)
1130 POKE 1024 + (QY+5)*40 + (QX+11), 32 : REM SPACE (PROFILE HIDDEN)
1140 RETURN

2000 REM --- PAINT COLOR SUBROUTINE (COL, QX, QY) ---
2010 FOR Y = 0 TO 11
2020   FOR X = 0 TO 19
2030     POKE 55296 + (QY+Y)*40 + (QX+X), COL
2040   NEXT X
2050 NEXT Y
2060 RETURN
