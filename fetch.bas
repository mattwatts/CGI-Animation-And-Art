10 REM LOGIC GARDEN 64AB: FETCH
20 PRINT CHR$(147) : REM CLEAR
30 V = 53248 : REM VIC BASE
40 POKE 53280, 14 : POKE 53281, 6 : REM COLORS

50 REM --- SETUP SPRITE POINTERS ---
60 S = 12288 : REM SCREEN RAM + 1016
70 POKE S, 192 : REM SPRITE 0 (KID)
80 POKE S+1, 193 : REM SPRITE 1 (DOG)
90 POKE S+2, 194 : REM SPRITE 2 (BALL)

100 REM --- DEFINE SPRITE DATA (BLOCK 192) ---
110 A = 12288 : REM THIS IS USUALLY END OF SCREEN, SAFE FOR DEMO
115 FOR I = 0 TO 62 : READ B : POKE A+I, B : NEXT
116 FOR I = 0 TO 62 : READ B : POKE A+64+I, B : NEXT
117 FOR I = 0 TO 62 : READ B : POKE A+128+I, B : NEXT

120 REM --- CONFIGURE SPRITES ---
130 POKE V+21, 7 : REM ENABLE 0, 1, 2
140 POKE V+39, 3 : REM KID CYAN
150 POKE V+40, 9 : REM DOG BROWN
160 POKE V+41, 2 : REM BALL RED
170 POKE V+23, 3 : REM EXPAND Y (KID/DOG)
180 POKE V+29, 3 : REM EXPAND X (KID/DOG)

190 REM --- MAIN POSITION LOOP ---
200 KX = 50 : KY = 150 : REM KID POS
210 DX = 250 : DY = 160 : REM DOG POS
220 POKE V, KX : POKE V+1, KY
230 POKE V+2, DX : POKE V+3, DY

240 REM --- THROW ANIMATION ---
250 FOR T = 0 TO 30
260 BX = KX + 20 + (T * 6)
270 BY = KY + 20 - (SIN(T/10)*50) : REM ARK
280 IF BX > 255 THEN POKE V+16, 4 : REM MSB FOR BALL
290 POKE V+4, (BX AND 255) : POKE V+5, BY
300 NEXT T

310 REM --- CATCH FLUSH ---
320 FOR F = 1 TO 10
330 POKE 53281, 14 : POKE 53281, 6
340 NEXT F
350 GOTO 240

