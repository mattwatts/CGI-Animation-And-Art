10 REM *** LOGIC GARDEN 64R: TAXI DRIVER ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,0: POKE 53281,0: PRINT CHR$(147)

100 REM *** PHASE 1: THE DIRTY APARTMENT ***
110 REM WALLPAPER (BROWN/GREY GRIME)
120 FOR I=0 TO 999
130 R=INT(RND(1)*4): C=9: IF R=1 THEN C=11: IF R=2 THEN C=12
140 POKE SC+I, 102: POKE CO+I, C
150 NEXT I

160 REM THE MIRROR FRAME (LIGHT GREY)
170 FOR Y=5 TO 20
180  POKE SC+(Y*40)+12, 160: POKE CO+(Y*40)+12, 1
190  POKE SC+(Y*40)+27, 160: POKE CO+(Y*40)+27, 1
200  FOR X=13 TO 26
210   POKE SC+(Y*40)+X, 32: REM CLEAR GLASS (BLACK REFLECTION)
220  NEXT X
230 NEXT Y
240 REM MIRROR TOP/BOT
250 FOR X=12 TO 27: POKE SC+(5*40)+X, 160: POKE CO+(5*40)+X, 1: NEXT
260 FOR X=12 TO 27: POKE SC+(20*40)+X, 160: POKE CO+(20*40)+X, 1: NEXT

300 REM *** SPRITE DATA LOAD ***
310 P=12288 :REM $3000 (BLK 192)
320 REM SPRITE 0: JACKET (GREEN BLOB)
330 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
340 REM SPRITE 1A: MOHAWK + EYES (BLACK)
350 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT
360 REM SPRITE 1B: MOHAWK + GUN EXTENDED
370 FOR I=0 TO 62: READ D: POKE P+128+I, D: NEXT

400 REM *** SPRITE SETUP ***
410 POKE V+21, 3: REM ENABLE 0 & 1
420 POKE V+39, 5:  REM SP0 = GREEN (JACKET)
430 POKE V+40, 0:  REM SP1 = BLACK (DETAIL)
440 POKE 2040, 192: POKE 2041, 193
450 X=160: Y=180

500 REM *** ACT 1: "YOU TALKIN' TO ME?" ***
510 PRINT CHR$(19): PRINT TAB(13); "YOU TALKIN' TO ME?"
520 FOR T=1 TO 6
530  OFFSET = INT(SIN(T)*5)
540  POKE V, X+OFFSET: POKE V+1, Y
550  POKE V+2, X+OFFSET: POKE V+3, Y
560  FOR D=1 TO 200: NEXT
570 NEXT T
580 PRINT CHR$(19): PRINT "                      " :REM CLEAR TEXT

600 REM *** ACT 2: "I DON'T SEE ANYONE ELSE" ***
610 PRINT CHR$(19): PRINT TAB(10); "I DON'T SEE ANYONE..."
620 FOR T=1 TO 4
630  OFFSET = INT(COS(T)*3)
640  POKE V, X+OFFSET: POKE V+1, Y
650  POKE V+2, X+OFFSET: POKE V+3, Y
660  FOR D=1 TO 200: NEXT
670 NEXT T
680 PRINT CHR$(19): PRINT "                      "

700 REM *** ACT 3: THE SNAP (GUN) ***
710 REM AUDIO SETUP (MECHANICAL SLIDE)
720 POKE S+24, 7: POKE S+5, 0: POKE S+6, 240
730 POKE S+1, 30: POKE S, 0

740 REM TRIGGER
750 POKE 2041, 194 :REM SWAP TO GUN SPRITE
760 POKE S+4, 129  :REM NOISE WAVE ON
770 FOR D=1 TO 50: NEXT
780 POKE S+4, 128  :REM NOISE OFF
790 FOR I=1 TO 500: NEXT :REM HOLD POSE

800 GOTO 440 :REM RESET LOOP

