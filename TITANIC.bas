10 REM *** LOGIC GARDEN 64S: TITANIC ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,6: POKE 53281,14: PRINT CHR$(147) :REM BLUE BORDER / LT BLUE SKY

100 REM *** PHASE 1: THE SHIP (PETSCII) ***
110 REM DRAW HORIZON
120 FOR X=0 TO 39: POKE SC+(10*40)+X, 160: POKE CO+(10*40)+X, 3: NEXT :REM CYAN LINE
130 REM DRAW OCEAN
140 FOR Y=11 TO 24: FOR X=0 TO 39
150 POKE SC+(Y*40)+X, 160: POKE CO+(Y*40)+X, 6 :REM BLUE
160 NEXT X: NEXT Y

170 REM DRAW BOW (BLACK WEDGE)
180 FOR Y=12 TO 24
190  W = (Y-12) + 2
200  START = 20 - W
210  END_X = 20 + W
220  FOR X=START TO END_X
230   POKE SC+(Y*40)+X, 160: POKE CO+(Y*40)+X, 0 :REM BLACK HULL
240  NEXT X
250  REM RAILING (WHITE)
260  POKE SC+(Y*40)+START, 160: POKE CO+(Y*40)+START, 1
270  POKE SC+(Y*40)+END_X, 160: POKE CO+(Y*40)+END_X, 1
280 NEXT Y

300 REM *** SPRITE DATA (JACK) ***
310 P=12288 :REM $3000
320 REM JACK (ARMS DOWN)
330 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
340 REM JACK (ARMS OUT)
350 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT

400 REM *** SPRITE SETUP ***
410 POKE V+21, 1: REM ENABLE 0
420 POKE V+39, 1: REM JACK = WHITE (SHIRT)
430 POKE 2040, 192 :REM START ARMS DOWN
440 POKE V, 172: POKE V+1, 100 :REM POS BOW TIP

500 REM *** THE MOMENT ***
510 PRINT CHR$(19): PRINT TAB(10);"FABRIZIO! LOOK!"
520 FOR T=1 TO 50: NEXT
530 POKE 2040, 193 :REM ARMS OUT
540 PRINT CHR$(19): PRINT TAB(10);"I'M KING OF THE WORLD!"

600 REM *** WIND AUDIO ***
610 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240
620 POKE S+4, 129 :REM NOISE
630 REM SWEEP FILTER (WIND GUSTS)
640 FOR I=0 TO 255 STEP 5
650  POKE S+22, I :REM FILTER CUTOFF
660  POKE S+23, 240 :REM RES
670  FOR D=1 TO 10: NEXT
680 NEXT I
690 GOTO 640

