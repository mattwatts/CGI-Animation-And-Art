10 REM *** LOGIC GARDEN 64Q: OCP BOARDROOM ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,15: POKE 53281,12: PRINT CHR$(147) :REM GREY/LT GREY

100 REM *** SPRITE DATA (ED-209) ***
110 P=12288 :REM $3000
120 REM TOP HALF (HEAD/SHOULDERS)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM BOT HALF (LEGS/GUNS)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT

200 REM *** SPRITE SETUP (MEGA MODE) ***
210 POKE V+21, 3: REM ENABLE 0,1
220 POKE V+23, 3: REM EXPAND Y
230 POKE V+29, 3: REM EXPAND X
240 POKE V+39, 11: POKE V+40, 11 :REM DARK GREY
250 POKE 2040, 192: POKE 2041, 193
260 POKE V, 100: POKE V+1, 100 :REM POS TOP
270 POKE V+2, 100: POKE V+3, 142 :REM POS BOT (OFFSET Y)

300 REM *** THE WARNING ***
310 PRINT CHR$(19): PRINT TAB(10);"PLEASE PUT DOWN YOUR WEAPON."
320 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240
330 POKE S+1, 15: POKE S, 0: POKE S+4, 17 :REM LOW GROWL
340 FOR T=20 TO 0 STEP -1
350  PRINT CHR$(19): PRINT TAB(10);"TOTAL COMPLIANCE IN: ";T
360  FOR D=1 TO 300: NEXT
370  POKE 53280, 2: FOR F=1 TO 10: NEXT: POKE 53280, 15 :REM RED FLASH
380 NEXT T
390 POKE S+4, 16 :REM SILENCE

400 REM *** THE GLITCH ***
410 PRINT CHR$(147): PRINT "I AM NOW AUTHORIZED TO USE"
420 PRINT "PHYSICAL FORCE."
430 FOR I=1 TO 500: NEXT

500 REM *** THE EXECUTION ***
510 REM NOISE GENERATOR
520 POKE S+4, 129
530 FOR I=1 TO 50
540  REM SCREEN FLASH CHAOS
550  C = INT(RND(1)*16)
560  POKE 53281, C
570  POKE V+39, 0 :REM ED-209 TURNS BLACK
580  FOR D=1 TO 20: NEXT
590  POKE V+39, 11
600 NEXT I
610 POKE 53281, 12 :REM RESTORE BG
620 POKE S+4, 128 :REM SILENCE
630 PRINT "MEDIC..."
640 GOTO 640

