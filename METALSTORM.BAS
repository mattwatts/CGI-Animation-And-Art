10 REM *** LOGIC GARDEN 64X: METAL STORM ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272
40 POKE 53280,0: POKE 53281,0: PRINT CHR$(147)

100 REM *** SPRITE DATA ***
110 P=12288
120 REM MISSILE (RED)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM GUN (CYAN)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT
160 REM RETICLE (GREEN BOX)
170 FOR I=0 TO 62: READ D: POKE P+128+I, D: NEXT

200 REM *** SETUP ***
210 POKE V+21, 63 :REM ENABLE 6 SPRITES
220 FOR I=0 TO 3: POKE V+39+I, 2: POKE 2040+I, 192: NEXT :REM RED MISSILES
230 POKE V+43, 3: POKE 2044, 193 :REM CYAN GUN
240 POKE V+44, 5: POKE 2045, 194 :REM GREEN RETICLE
250 GX=160: GY=220
260 POKE V+8, GX: POKE V+9, GY

300 REM *** MAIN LOOP ***
310 PRINT CHR$(19): PRINT "    THREAT DETECTION ACTIVE"
320 MX=50: MY=0 :REM MISSILE START
330 VX=2: VY=2

340 FOR T=1 TO 100
350  REM UPDATE MISSILE POS
360  MX = MX + VX: MY = MY + VY
370  POKE V, MX: POKE V+1, MY
380  
390  REM CALCULATE LEAD (THE LOGIC)
400  LEADX = MX + (VX*10)
410  LEADY = MY + (VY*10)
420  POKE V+10, LEADX: POKE V+11, LEADY :REM MOVE RETICLE
430  
440  REM ENGAGE RANGE
450  IF MY > 100 THEN GOSUB 600 :REM FIRE!
460  
470  REM IMPACT
480  IF MY > 200 THEN MX=INT(RND(1)*300): MY=0: VY=RND(1)*4+1
490 NEXT T
500 GOTO 320

600 REM *** BRRRRRT (FIRE) ***
610 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240
620 POKE S+4, 129 :REM NOISE
630 POKE 53281, 1 :REM WHITE FLASH STREAM
640 FOR D=1 TO 5: NEXT
650 POKE 53281, 0
660 POKE S+4, 128
670 PRINT CHR$(19): PRINT "    SPLASH ONE."
680 REM RESET MISSILE (KILLED)
690 MX=INT(RND(1)*300): MY=0: REM TRIGGER EXPLOSION ANIM HERE
700 RETURN

