10 REM *** LOGIC GARDEN 64U: T3 HIVE MIND ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,0: POKE 53281,0: PRINT CHR$(147)

100 REM *** SPRITE DATA ***
110 P=12288 :REM $3000
120 REM T-1 BOT (CYAN BLOCK)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM TARGET (RED X)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT

200 REM *** HIVEMIND SETUP ***
210 POKE V+21, 255: REM ENABLE ALL 8 SPRITES
220 FOR I=0 TO 4
230  POKE V+39+I, 3 :REM CYAN HIVE UNITS
240  POKE 2040+I, 192 :REM POINTER
250  POKE V+(I*2), 50+(I*40) :REM X POS
260  POKE V+(I*2)+1, 200     :REM Y POS LINE
270 NEXT I

280 REM RED TARGET SETUP
290 POKE V+46, 2 :REM RED
300 POKE 2047, 193
310 TX=160: TY=50
320 POKE V+14, TX: POKE V+15, TY

400 REM *** THE ALGORITHM LOOP ***
410 PRINT CHR$(19): PRINT "    ACQUIRING TARGET..."
420 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240
430 POKE S+4, 17 :REM LOW HUM

440 REM VISUALISE CALCULATION (CURSOR)
450 CX=50: CY=200
460 FOR I=0 TO 20
470  CX = CX + (TX-CX)*0.2 :REM LERP TO TARGET X
480  CY = CY + (TY-CY)*0.2 :REM LERP TO TARGET Y
490  POKE 53280, 11 :REM GREY PULSE
500  FOR D=1 TO 20: NEXT
510  POKE 53280, 0
520 NEXT I

500 REM *** FOCUS FIRE ***
510 PRINT CHR$(19): PRINT "    EXECUTING..."
520 POKE S+4, 65 :REM PULSE WAVE (T-1 LASER)
530 POKE 53281, 3 :REM CYAN FLASH
540 FOR I=1 TO 10: NEXT
550 POKE 53281, 0
560 POKE S+4, 64 :REM OFF

600 REM *** TARGET DESTROYED ***
610 POKE V+14, 0 :REM HIDE TARGET
620 PRINT CHR$(19): PRINT "    THREAT NEUTRALIZED."
630 POKE S+4, 129 :REM EXPLOSION
640 FOR I=1 TO 50: NEXT: POKE S+4, 128

700 REM *** VICTORY DANCE ***
710 PRINT CHR$(19): PRINT "    INITIATING CELEBRATION PROTOCOL"
720 POKE S+24, 15: POKE S+4, 17
730 FOR L=1 TO 10
740  FOR I=0 TO 4
750   OFFSET = INT(SIN(L+I)*10)
760   POKE V+(I*2)+1, 200 + OFFSET
770   REM AUDIO SYNC
780   POKE S, 100+(OFFSET*5): POKE S+1, 10
790  NEXT I
800 NEXT L
810 GOTO 730 :REM DANCE FOREVER

