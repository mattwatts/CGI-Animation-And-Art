10 REM *** LOGIC GARDEN 64V: SKYNET SEARCH ***
20 POKE 53280,0: POKE 53281,0: PRINT CHR$(147)
30 S=1024: C=55296
40 REM GENERATE NOISE MAZE
50 FOR I=0 TO 999
60  R=INT(RND(1)*2)
70  IF R=1 THEN POKE S+I, 160: POKE C+I, 11 :REM GREY WALL
80  IF R=0 THEN POKE S+I, 32  :REM SPACE
90 NEXT I
100 REM HIDE NODES
110 POKE S+40, 81: POKE C+40, 7 :REM START 'Q'
120 POKE S+950, 88: POKE C+950, 7 :REM END 'X'

200 REM *** RED FLOOD (PANIC) ***
210 FOR I=1 TO 500
220  R=INT(RND(1)*1000)
230  IF PEEK(S+R)=32 THEN POKE S+R, 160: POKE C+R, 2 :REM RED BLOCK
240 NEXT I

300 REM *** CYAN LINE (A*) ***
310 PRINT CHR$(19): PRINT "    OPTIMIZING..."
320 X=1: Y=1
330 TX=39: TY=23
340 REM BRESENHAM LINE LOGIC IN BASIC
350 DX = TX-X: DY = TY-Y
360 FOR I=0 TO DX
370  NX = X + I
380  NY = Y + INT(I * (DY/DX))
390  LOC = S + (NY*40) + NX
400  POKE LOC, 160: POKE LOC+49152, 3 :REM CYAN BLOCK
410  FOR D=1 TO 10: NEXT
420 NEXT I
430 POKE 53280, 3 :REM FLASH
440 FOR I=1 TO 20: NEXT: POKE 53280, 0
