10 REM *** LOGIC GARDEN 64M: KANSAS TO OZ ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,0: POKE 53281,0: PRINT CHR$(147) :REM BLACK VOID

100 REM *** PHASE 1: KANSAS (SEPIA TONE) ***
110 REM FILL WALLS (GREY 12)
120 FOR I=0 TO 999: POKE SC+I, 160: POKE CO+I, 12: NEXT I
130 REM DRAW FLOOR (BROWN 9)
140 FOR I=15 TO 24: FOR J=0 TO 39
150 POKE SC+(I*40)+J, 160: POKE CO+(I*40)+J, 9
160 NEXT J: NEXT I
170 REM DRAW DOOR FRAME (DARK GREY 11)
180 FOR I=4 TO 19: FOR J=12 TO 27
190 POKE CO+(I*40)+J, 11
200 NEXT J: NEXT I

300 REM *** PHASE 2: DOROTHY (SPRITE 0) ***
310 FOR I=0 TO 62: POKE 12288+I, 255: NEXT :REM BLOCK SHAPE
320 POKE 12288, 24: POKE 12288+1, 60: POKE 12288+2, 24 :REM HEAD
330 FOR I=3 TO 20: POKE 12288+I, 60: NEXT :REM BODY
340 FOR I=21 TO 60: POKE 12288+I, 126: NEXT :REM DRESS
350 POKE V+21, 1: POKE V+39, 15: REM ENABLE + LIGHT GREY
360 POKE V, 160: POKE V+1, 200: REM POSITION CENTER LOW

400 REM *** PHASE 3: THE TRANSITION ***
410 PRINT CHR$(19);"PRESS KEY TO OPEN DOOR"
420 GET K$: IF K$="" THEN 420
430 POKE S+24, 15: POKE S+5, 9: POKE S+6, 240: POKE S+4, 17 :REM AUDIO SETUP

500 REM *** THE REVEAL LOOP (COLUMNAR WIPE) ***
510 REM WE ERASE THE DOOR AREA LEFT TO RIGHT
520 FOR X=13 TO 26
530  REM SOUND EFFECT (RISING ARPEGGIO)
540  FREQ = 5000 + (X*200)
550  HI = INT(FREQ/256): LO = FREQ - (HI*256)
560  POKE S+1, LO: POKE S, HI
570  POKE S+4, 17: REM TRIGGER NOTE

580  FOR Y=5 TO 19 :REM DOOR HEIGHT
590   ADDR = SC + (Y*40) + X
600   C_ADDR = CO + (Y*40) + X
610   
620   REM *** THE OZ ALGORITHM ***
630   REM DEFAULT: SKY (CYAN SPACE)
640   CHAR = 32: COL = 3
650   
660   REM HORIZON (CITY)
670   IF Y=12 OR Y=13 THEN CHAR=160: COL=13
680   
690   REM EMERALD CITY SPIRE
700   IF Y<12 AND X=19 OR X=20 THEN CHAR=226: COL=13
710   
720   REM GROUND LOGIC
730   IF Y > 13 THEN CHAR=160: COL=5 :REM GRASS (GREEN)
740   
750   REM YELLOW BRICK ROAD (PERSPECTIVE)
760   REM ROAD GETS WIDER AS Y INCREASES
770   DIST_FROM_CENTER = ABS(X - 20)
780   ROAD_WIDTH = (Y - 12) / 2
790   IF Y>13 AND DIST_FROM_CENTER <= ROAD_WIDTH THEN COL=7 :REM YELLOW
800   
810   POKE ADDR, CHAR: POKE C_ADDR, COL
820  NEXT Y
830  
840  FOR D=1 TO 50: NEXT D :REM SLOW DOWN THE OPENING
850  POKE S+4, 16 :REM RELEASE NOTE
860 NEXT X

600 REM *** FINALE ***
610 POKE S+24, 0: REM SILENCE
620 PRINT CHR$(19);"            WELCOME TO OZ"
630 GOTO 630
