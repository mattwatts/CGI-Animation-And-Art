10 REM LOGIC GARDEN 113: THE WALKER
20 PRINT CHR$(147) : REM CLEAR SCREEN
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK BACKGROUND/BORDER

40 REM --- SPRITE SETUP ---
50 V = 53248 : REM VIC-II BASE ADDRESS
60 POKE 2040, 192 : REM SET SPRITE 0 POINTER TO BLOCK 192 (ADR 12288)
70 FOR I = 0 TO 62 : READ D : POKE 12288+I, D : NEXT I

100 REM --- CONFIGURE SPRITE 0 ---
110 POKE V+21, 1 : REM ENABLE SPRITE 0
120 POKE V+39, 3 : REM COLOR CYAN (SHIRT) - MULTICOLOR WOULD BE BETTER FOR SHORTS, BUT SOLIDS POP MORE
130 POKE V+23, 1 : REM EXPAND Y
140 POKE V+29, 1 : REM EXPAND X

200 REM --- MAIN LOOP ---
210 Y = 150 : POKE V+1, Y
220 FOR X = 0 TO 345
230   REM MSB LOGIC FOR X COORDINATE > 255
240   IF X < 256 THEN POKE V, X : POKE V+16, 0
250   IF X >= 256 THEN POKE V, X-256 : POKE V+16, 1
260   REM ANIMATION DELAY
270   FOR W = 0 TO 10 : NEXT W
280 NEXT X
290 GOTO 200

1000 REM --- SPRITE DATA ---
1010 DATA 0,60,0, 0,60,0, 0,60,0
1020 DATA 0,255,0, 0,255,0, 0,255,0
1030 DATA 0,255,0, 0,255,0, 0,195,0
1040 DATA 0,195,0, 0,195,0, 0,195,0
1050 DATA 0,66,0, 0,66,0, 0,36,0
1060 DATA 0,36,0, 0,36,0, 0,0,0
1070 FOR K=1 TO 45:DATA 0:NEXT K : REM FILL REST WITH 0
