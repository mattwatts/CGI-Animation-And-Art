10 REM *** LOGIC GARDEN 64O: DIRTY DANCING ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,0: POKE 53281,11: PRINT CHR$(147) :REM BLACK/GREY POOL ROOM

100 REM *** SPRITE DATA LOAD ***
110 P=12288 :REM BLOCK 192 ($3000)
120 REM BABY (DRESS SHAPE)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM JOHNNY (TALL/COOL FRAME)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT

200 REM *** SPRITE SETUP ***
210 POKE V+21, 3: REM ENABLE 0 & 1
220 POKE V+39, 10: REM BABY = LIGHT RED (PINK)
230 POKE V+40, 0:  REM JOHNNY = BLACK
240 POKE 2040, 192: POKE 2041, 193

300 REM *** ACT 1: THE CORNER ***
310 BX=50: BY=200 :REM BABY COORDS
320 JX=300: JY=200 :REM JOHNNY OFF SCREEN
330 POKE V, BX: POKE V+1, BY
340 POKE V+2, 44: POKE V+3, JY: POKE V+16, 2 :REM JOHNNY MSB SET
350 PRINT CHR$(19): POKE 1984, 32 :REM CLEAR BOTTOM
360 PRINT TAB(10); "WAITING IN THE CORNER..."

400 REM *** JOHNNY ENTERS ***
410 FOR X=300 TO 80 STEP -2
420  MSB=0: IF X>255 THEN MSB=2: TX=X-256 ELSE TX=X
430  POKE V+2, TX: POKE V+16, MSB
440  FOR D=1 TO 10: NEXT
450 NEXT X

500 REM *** THE LINE ***
510 FOR I=1 TO 500: NEXT :REM DRAMATIC PAUSE
520 PRINT CHR$(147)
530 PRINT CHR$(158); :REM YELLOW TEXT
540 POKE 1986, 0 :REM CURSOR POS
550 PRINT "NOBODY PUTS BABY IN A CORNER."
560 FOR I=1 TO 1000: NEXT

600 REM *** ACT 2: TO CENTER STAGE ***
610 REM WALK TOGETHER TO X=160
620 FOR W=0 TO 80
630  BX=BX+1: JX=80+W
640  POKE V, BX: POKE V+2, JX
650  FOR D=1 TO 10: NEXT
660 NEXT W

700 REM *** ACT 3: THE LIFT ***
710 PRINT CHR$(147): PRINT TAB(12);"THE TIME OF MY LIFE"
720 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240 :REM SID ENV
730 POKE S+4, 17 :REM TRIANGLE WAVE

740 REM JOHNNY PLANTS FEET
750 REM BABY GOES UP
760 FOR H=0 TO 60
770  BY=200-H
780  POKE V+1, BY
790  
800  REM MUSIC SWELL (RISING PITCH)
810  FREQ = 2000 + (H*100)
820  HI=INT(FREQ/256): LO=FREQ-(HI*256)
830  POKE S, LO: POKE S+1, HI
840  
850  REM SPOTLIGHT EFFECT (FLASH BACKGROUND)
860  IF H>40 THEN C=INT(RND(1)*2): IF C=1 THEN POKE 53281, 3 ELSE POKE 53281, 1
870  
880  FOR D=1 TO 20: NEXT
890 NEXT H

900 REM *** THE FREEZE FRAME ***
910 POKE 53281, 3 :REM CYAN VICTORY BACKGROUND
920 POKE S+4, 16 :REM RELEASE NOTE
930 GOTO 930

