1010 DATA 0,24,0, 0,24,0, 0,60,0, 0,60,0, 0,126,0, 0,126,0
1020 DATA 0,255,0, 1,255,128, 1,255,128, 3,255,192, 3,255,192, 7,255,224
1030 DATA 7,255,224, 15,255,240, 0,24,0, 0,24,0, 0,24,0, 0,0,0
1040 DATA 0,0,0, 0,0,0, 0,0,0 :REM PADDING
1050 DATA 0,0,0, 0,0,0, 0,0,0

