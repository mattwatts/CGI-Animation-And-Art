10 REM *** LOGIC GARDEN 64T: SAD HILL ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272: SC=1024: CO=55296
40 POKE 53280,0: POKE 53281,7: PRINT CHR$(147) :REM YELLOW DESERT

100 REM *** SPRITE DATA ***
110 P=12288 :REM $3000
120 REM BLONDIE (PONCHO)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM ANGEL EYES (SUIT)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT
160 REM TUCO (RAGS)
170 FOR I=0 TO 62: READ D: POKE P+128+I, D: NEXT

200 REM *** SPRITE SETUP ***
210 POKE V+21, 7: REM ENABLE 0,1,2
220 POKE V+39, 9: REM SP0 = BROWN
230 POKE V+40, 0: REM SP1 = BLACK
240 POKE V+41, 12: REM SP2 = GREY
250 POKE 2040, 192: POKE 2041, 193: POKE 2042, 194

260 REM TRIANGLE POSITIONS
270 POKE V, 160: POKE V+1, 200 :REM BLONDIE (BOT)
280 POKE V+2, 80: POKE V+3, 100 :REM TUCO (TOP LEFT)
290 POKE V+4, 240: POKE V+5, 100 :REM ANGEL (TOP RIGHT)

300 REM *** THE STANDOFF (MUSIC) ***
310 PRINT CHR$(19): PRINT TAB(13); "WAIT FOR IT..."
320 POKE S+24, 15: POKE S+5, 0: POKE S+6, 240
330 POKE S+4, 17 :REM TRIANGLE WAVE

340 FOR NOTE=10 TO 30
350  FREQ = NOTE * 200
360  HI=INT(FREQ/256): LO=FREQ-(HI*256)
370  POKE S, LO: POKE S+1, HI
380  
390  REM CHECK FOR PREMATURE FIRE
400  GET K$: IF K$=" " THEN GOTO 600 :REM TOO EARLY
410  
420  REM TENSION DELAY
430  FOR D=1 TO 50: NEXT
440 NEXT NOTE

500 REM *** THE DRAW WINDOW ***
510 POKE 53280, 1 :REM WHITE BORDER FLASH (SIGNAL)
520 FOR W=1 TO 20 :REM REACTION WINDOW
530  GET K$: IF K$=" " THEN GOTO 700 :REM SUCCESS
540  FOR D=1 TO 10: NEXT
550 NEXT W
560 GOTO 800 :REM TOO LATE

600 REM *** DIED: TOO EARLY (TUCO) ***
610 PRINT "TUCO SHOT YOU! (TOO NERVOUS)"
620 POKE S+4, 129 :REM NOISE
630 GOTO 630

700 REM *** SUCCESS: BLONDIE WINS ***
710 POKE V+21, 5 :REM ANGEL EYES VANISHES (DIES)
720 POKE 53280, 0 :REM BACK TO BLACK
730 PRINT CHR$(147): PRINT TAB(10); "BLONDIE WINS."
740 POKE S+4, 129 :REM GUNSHOT
750 FOR D=1 TO 20: NEXT: POKE S+4, 128
760 GOTO 760

800 REM *** DIED: TOO LATE (ANGEL EYES) ***
810 PRINT "ANGEL EYES SHOT YOU! (TOO SLOW)"
820 POKE S+4, 129
830 GOTO 830

