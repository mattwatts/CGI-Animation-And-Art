10 REM LOGIC GARDEN 64Z: LUDICROUS SPEED
20 POKE 53280,0 : POKE 53281,0 : PRINT CHR$(147)
30 REM --- LIGHT SPEED ---
40 PRINT CHR$(5); "LIGHT SPEED"
50 FOR I=1 TO 500
60 X=INT(RND(1)*40) : Y=INT(RND(1)*25)
70 POKE 1024+X+Y*40, 46 : REM PRINT DOT
80 NEXT I
90 FOR T=1 TO 1000 : NEXT T
100 REM --- RIDICULOUS SPEED ---
110 POKE 53280,2 : POKE 53281,0 : PRINT CHR$(147)
120 PRINT CHR$(28); "RIDICULOUS SPEED"
130 FOR I=1 TO 200
140 PRINT "|        |    |       |"
150 NEXT I
200 REM --- LUDICROUS SPEED ---
210 POKE 53280,7 : PRINT CHR$(147)
220 PRINT CHR$(30); "LUDICROUS SPEED!"
230 FOR K=1 TO 50 : POKE 53281, INT(RND(1)*16) : NEXT K
300 REM --- PLAID ---
310 PRINT CHR$(147) : POKE 53281, 0 : POKE 53280, 0
320 PRINT CHR$(158); "THEY'VE GONE TO PLAID!"
330 FOR Y=0 TO 24
340 FOR X=0 TO 39
350 C = INT(RND(1)*4) + 1
360 IF C=1 THEN CC=28 : REM RED
370 IF C=2 THEN CC=30 : REM GREEN
380 IF C=3 THEN CC=31 : REM BLUE
390 IF C=4 THEN CC=156 : REM PURPLE
400 PRINT CHR$(CC); CHR$(160); : REM REVERSE SPACE BLOCK
410 NEXT X
420 NEXT Y
430 GOTO 330
