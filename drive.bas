10 REM LOGIC GARDEN 64AC: NIGHT DRIVE
20 PRINT CHR$(147) : POKE 53280,0 : POKE 53281,0 : REM BLACK SCREEN

30 REM --- DEFINE SPRITE (CAR) ---
40 V = 53248 : REM VIC
50 S = 12288 : REM POINTERS
60 POKE S, 192 : REM SPRITE 0
70 A = 12288 : REM DATA START
80 REM READ DATA INTO 192
90 FOR I = 0 TO 62 : READ B : POKE A+I, B : NEXT

100 REM --- SETUP SPRITE ---
110 POKE V+21, 1 : REM ENABLE SPRITE 0
120 POKE V+39, 2 : REM COLOR RED
130 POKE V+23, 3 : REM EXPAND Y
140 POKE V+29, 3 : REM EXPAND X
150 X = 100 : Y = 150
160 POKE V, X : POKE V+1, Y

200 REM --- ROAD LOOP ---
210 PRINT "{CLR}"
220 FOR T = 1 TO 24
230 PRINT TAB(0); "               _ _ _ _ _"
240 NEXT T

300 REM --- MAIN LOOP ---
310 FOR I = 0 TO 100
320 REM ANIMATE WHEELS VIA Y-JITTER
330 BUMP = INT(RND(1)*3)
340 POKE V+1, Y + BUMP
350 REM SIMULATE ROAD MOVEMENT VIA BORDER FLASH? NO, TOO NOISY.
360 REM PRINT A NEW LINE AT BOTTOM TO SCROLL SCREEN
370 PRINT "       -       -       -       -"
380 NEXT I
390 GOTO 300

