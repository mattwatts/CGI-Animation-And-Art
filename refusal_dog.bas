10 REM LOGIC GARDEN 120: DOG REFUSAL
20 PRINT CHR$(147) : REM CLEAR
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK

40 REM --- SPRITE POINTERS ---
50 REM 200 = RIGHT FACING, 201 = LEFT FACING
60 POKE 2040, 200 : REM START FACING RIGHT

100 REM --- SETUP ---
110 V = 53248
120 POKE V+21, 1 : REM ENABLE SPR 0
130 POKE V+39, 7 : REM YELLOW
140 POKE V+23, 1 : POKE V+29, 1 : REM EXPAND
150 POKE V+1, 150

200 REM --- PHASE 1: ENTER FROM LEFT ---
210 FOR X = 0 TO 170 STEP 2
220   GOSUB 1000 : REM POSITION
230   FOR D = 0 TO 5 : NEXT D
240 NEXT X

300 REM --- PHASE 2: PAUSE ---
310 FOR T = 0 TO 800 : NEXT T

400 REM --- PHASE 3: TURN ---
410 POKE 2040, 201 : REM SWAP TO LEFT FACING
420 FOR T = 0 TO 300 : NEXT T

500 REM --- PHASE 4: EXIT TO LEFT ---
510 FOR X = 170 TO 0 STEP -3
520   GOSUB 1000
530   FOR D = 0 TO 5 : NEXT D
540 NEXT X

600 END

1000 REM --- X LOGIC ---
1010 IF X < 256 THEN POKE V, X : POKE V+16, 0 : RETURN
1020 IF X >= 256 THEN POKE V, X-256 : POKE V+16, 1 : RETURN
