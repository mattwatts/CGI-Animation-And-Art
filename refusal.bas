10 REM LOGIC GARDEN 118: REFUSAL
20 PRINT CHR$(147) : REM CLEAR
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK

40 REM --- SPRITES ---
50 V = 53248
60 POKE 2040, 200 : REM START FACING RIGHT
70 POKE V+21, 1 : POKE V+39, 3 : POKE V+23, 1 : POKE V+29, 1
80 POKE V+1, 150

100 REM --- PHASE 1: WALK RIGHT TO CENTER ---
110 FOR X = 0 TO 170 STEP 2
120   GOSUB 1000 : REM X LOGIC
130   FOR W=0 TO 5 : NEXT W
140 NEXT X

200 REM --- PHASE 2: PAUSE ---
210 FOR T = 0 TO 1000 : NEXT T

300 REM --- PHASE 3: TURN (REFUSE) ---
310 POKE 2040, 201 : REM SWAP TO LEFT FACING
320 FOR T = 0 TO 500 : NEXT T

400 REM --- PHASE 4: WALK LEFT TO EXIT ---
410 FOR X = 170 TO 0 STEP -2
420   GOSUB 1000 : REM X LOGIC
430   FOR W=0 TO 5 : NEXT W
440 NEXT X

500 END

1000 REM --- X LOGIC ---
1010 IF X < 256 THEN POKE V, X : POKE V+16, 0 : RETURN
1020 IF X >= 256 THEN POKE V, X-256 : POKE V+16, 1 : RETURN
