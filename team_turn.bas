10 REM LOGIC GARDEN 121: TEAM TURN
20 PRINT CHR$(147) : REM CLEAR
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK

40 REM --- POINTERS ---
50 REM 200/201 (DOG R/L), 202/203 (BOY R/L)
60 POKE 2040, 201 : REM DOG LEFT
70 POKE 2041, 203 : REM BOY LEFT

100 REM --- VIC SETUP ---
110 V = 53248
120 POKE V+21, 3 : REM ENABLE 0 & 1
130 POKE V+39, 7 : REM DOG YELLOW
140 POKE V+40, 3 : REM BOY CYAN
150 POKE V+23, 3 : POKE V+29, 3 : REM EXPAND BOTH
160 POKE V+1, 150 : POKE V+3, 145 : REM Y POS

200 REM --- WALK IN (LEFT) ---
210 FOR X = 345 TO 170 STEP -2
220   BX = X : DX = X - 45 : REM DOG LEADS (LEFTWARD)
230   GOSUB 1000 : REM POS LOGIC
240   FOR W=0 TO 5:NEXT W
250 NEXT X

300 REM --- PAUSE ---
310 FOR T = 0 TO 800 : NEXT T

400 REM --- TURN ---
410 POKE 2040, 200 : REM DOG RIGHT
420 POKE 2041, 202 : REM BOY RIGHT
430 FOR T = 0 TO 300 : NEXT T

500 REM --- WALK OUT (RIGHT) ---
510 FOR X = 170 TO 345 STEP 3
520   BX = X : DX = X - 45 : REM DOG NOW FOLLOWS (RIGHTWARD)
530   GOSUB 1000
540   FOR W=0 TO 5:NEXT W
550 NEXT X

600 END

1000 REM --- DUAL SPRITE MSB LOGIC ---
1010 MSB = 0
1020 IF DX > 255 THEN DX = DX - 256 : MSB = MSB OR 1
1030 IF BX > 255 THEN BX = BX - 256 : MSB = MSB OR 2
1040 POKE V, DX : POKE V+2, BX
1050 POKE V+16, MSB
1060 RETURN
