10 REM LOGIC GARDEN 128: THE QUANTUM OCEAN (PAIR PRODUCTION)
20 PRINT CHR$(147) : REM CLEAR
30 POKE 53280, 0 : POKE 53281, 0 : REM ABSOLUTE VOID

40 REM --- SPRITE POINTERS (SOLID CIRCLES OR BLOBS) ---
50 POKE 2040, 200 : REM MATTER
60 POKE 2041, 200 : REM ANTIMATTER

100 REM --- VIC SETUP ---
110 V = 53248
120 POKE V+21, 3 : REM ENABLE 0,1
130 POKE V+39, 3 : REM C_CYAN
140 POKE V+40, 2 : REM C_RED
150 POKE V+23, 3 : POKE V+29, 3 : REM EXPAND X/Y
160 CX = 170 : CY = 145 : REM THE ZERO POINT

200 REM --- THE VOID (TATHATA) ---
210 POKE V, 0 : POKE V+1, 0 : POKE V+2, 0 : POKE V+3, 0 : REM HIDE
220 FOR T = 0 TO 800 : NEXT T

300 REM --- THE ERUPTION & ORBIT ---
310 R = 0 : REM RADIUS
320 FOR A = 0 TO 15 STEP 0.1
330   IF R < 50 THEN R = R + 1 : REM EMERGE
340   IF A > 12 THEN R = R - 2 : REM DECAY (GRAVITY)
350   IF R < 0 THEN R = 0
360   
370   REM CALCULATE TRAJECTORIES WITH SINE/COSINE
380   X1 = CX + (SIN(A) * R)
390   Y1 = CY + (COS(A) * R)
400   X2 = CX + (SIN(A + 3.14) * R)
410   Y2 = CY + (COS(A + 3.14) * R)
420   
430   REM UPDATE VIC
440   POKE V, X1 : POKE V+1, Y1
450   POKE V+2, X2 : POKE V+3, Y2
460   
470   FOR W = 0 TO 15 : NEXT W : REM SPEED LIMITER
480 NEXT A

400 REM --- ANNIHILATION FLASH ---
410 POKE V+21, 0 : REM DISABLE SPRITES (NON-EXISTENCE)
420 POKE 53280, 1 : POKE 53281, 1 : REM WHITE FLASH (ENERGY)
430 FOR T = 0 TO 15 : NEXT T
440 POKE 53280, 0 : POKE 53281, 0 : REM RETURN TO VOID

500 REM --- SILENCE ---
510 FOR T = 0 TO 1000 : NEXT T
520 END
