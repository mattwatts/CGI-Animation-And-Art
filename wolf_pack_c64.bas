10 REM *** LOGIC GARDEN 64Y: WOLF PACK ***
20 REM *** MATT'S INDUSTRIALIST PROTOCOL ***
30 V=53248: S=54272
40 POKE 53280,0: POKE 53281,0: PRINT CHR$(147)

100 REM *** SPRITE DATA ***
110 P=12288
120 REM DESTROYER (GREEN/CYAN)
130 FOR I=0 TO 62: READ D: POKE P+I, D: NEXT
140 REM SUBMARINE (RED)
150 FOR I=0 TO 62: READ D: POKE P+64+I, D: NEXT

200 REM *** SETUP ***
210 POKE V+21, 15 :REM ENABLE 4 SPRITES
220 FOR I=0 TO 2
230  POKE V+39+I, 5 :REM GREEN SHIPS
240  POKE 2040+I, 192
250  POKE V+(I*2), 50+(I*60) :REM X POS
260  POKE V+(I*2)+1, 60      :REM Y POS
270 NEXT I

280 REM SUB SETUP (HIDDEN)
290 POKE 2043, 193
300 POKE V+42, 0 :REM BLACK (INVISIBLE)
310 SX=150: SY=200
320 POKE V+6, SX: POKE V+7, SY
330 LOCKS=0

400 REM *** MAIN LOOP ***
410 PRINT CHR$(19): PRINT "    ACTIVE SONAR: READY"
420 GET K$: IF K$<>"P" THEN GOTO 500

430 REM *** PING SEQUENCE ***
440 PRINT "    PING TRANSMITTED..."
450 REM AUDIO PING
460 POKE S+24, 15: POKE S+5, 9: POKE S+6, 0 :REM ADSR
470 POKE S+1, 30: POKE S, 0 :REM HIGH PITCH
480 POKE S+4, 17 :REM TRIANGLE ON
490 POKE 53281, 5 :REM GREEN FLASH
500 POKE 53281, 0
510 POKE S+4, 16 :REM OFF

520 REM MOVE SUB (SNEAKY)
530 SX = SX + (RND(1)*4 - 2)
540 IF SX > 300 THEN SX=50
550 IF SX < 40 THEN SX=250
560 POKE V+6, SX

570 REM CHECK ECHO (KEY PRESS PART 2)
580 IF K$="P" THEN GOSUB 700

590 REM CHECK LOCKS
600 IF LOCKS >= 3 THEN GOTO 800
610 GOTO 420

700 REM *** RETURN ECHO ***
710 REM SIMPLE DISTANCE CHECK TO CENTER SHIP
720 DIST = ABS(SX - 170)
730 IF DIST < 40 THEN GOTO 760
740 RETURN

760 REM CONTACT!
770 PRINT "    CONTACT DETECTED!"
780 POKE V+42, 2 :REM SUB TURNS RED
790 FOR D=1 TO 50: NEXT
800 POKE V+42, 0 :REM SUB HIDES
810 LOCKS = LOCKS + 1
820 REM ECHO SOUND
830 POKE S+1, 15: POKE S+4, 17: FOR D=1 TO 20: NEXT: POKE S+4, 16
840 RETURN

800 REM *** KILL SOLUTION ***
810 PRINT CHR$(147): PRINT "    FIRING SOLUTION LOCKED."
820 POKE V+42, 2 :REM REVEAL SUB
830 POKE S+4, 129 :REM EXPLOSION NOISE
840 POKE 53280, 1 :REM WHITE FLASH
850 FOR I=1 TO 50: NEXT
860 POKE 53280, 0
870 PRINT "    TARGET ELIMINATED."
880 END

