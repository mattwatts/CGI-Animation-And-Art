10 REM LOGIC GARDEN 64A: BICYCLE
20 PRINT CHR$(147) : REM CLEAR SCREEN
30 V = 53248 : REM VIC-II BASE ADDRESS
40 S = 12288 : REM SPRITE POINTERS (SCREEN RAM + 1016)
50 D = 12800 : REM SPRITE DATA LOCATION (BLOCK 200)

60 REM --- SETUP COLORS ---
70 POKE 53280, 14 : REM BORDER LIGHT BLUE
80 POKE 53281, 6  : REM BG BLUE

90 REM --- DEFINE SPRITE ---
100 FOR I = 0 TO 62 : READ B : POKE D+I, B : NEXT
110 POKE S, 200 : REM POINTER TO SPRITE 0

120 REM --- ENABLE SPRITE ---
130 POKE V+21, 1 : REM ENABLE SPRITE 0
140 POKE V+39, 7 : REM SPRITE 0 COLOR (YELLOW)
150 POKE V+23, 1 : REM EXPAND Y
160 POKE V+29, 1 : REM EXPAND X

200 REM --- ANIMATION LOOP ---
210 FOR X = 0 TO 255
220 POKE V, X : REM SET X POS
230 POKE V+1, 150 : REM SET Y POS
240 NEXT X
250 GOTO 210

1000 REM --- SPRITE DATA (THE KID) ---
1010 DATA 0,60,0, 0,60,0, 0,255,0, 1,255,128, 3,255,192
1020 DATA 3,255,192, 7,255,224, 7,129,224, 15,129,240, 15,255,240
1030 DATA 31,255,248, 0,255,0, 0,255,0, 1,195,128, 3,129,192
1040 DATA 3,0,192, 6,0,96, 12,0,48, 24,0,24, 48,255,12
1050 DATA 0,0,0, 0,0,0
