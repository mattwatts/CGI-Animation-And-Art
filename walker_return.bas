10 REM LOGIC GARDEN 116: WALKER RETURN
20 PRINT CHR$(147) : REM CLEAR SCREEN
30 POKE 53280, 0 : POKE 53281, 0 : REM BLACK BACKGROUND

40 REM --- SPRITE SETUP ---
50 V = 53248
60 POKE 2040, 192 : REM SPRITE 0 POINTER TO BLOCK 192 (12288)
70 FOR I = 0 TO 62 : READ D : POKE 12288+I, D : NEXT I

100 REM --- CONFIGURE SPRITE 0 ---
110 POKE V+21, 1 : REM ENABLE SPRITE 0
120 POKE V+39, 3 : REM COLOR CYAN
130 POKE V+23, 1 : REM EXPAND Y
140 POKE V+29, 1 : REM EXPAND X
150 POKE V+1, 150 : REM Y-COORD

200 REM --- MOVEMENT LOOP (RIGHT TO LEFT) ---
210 FOR X = 345 TO 0 STEP -1
220   REM MSB LOGIC
230   IF X > 255 THEN POKE V, X-256 : POKE V+16, 1
240   IF X <= 255 THEN POKE V, X : POKE V+16, 0
250   REM ANIMATION DELAY
260   FOR W = 0 TO 10 : NEXT W
270 NEXT X
280 GOTO 210

1000 REM --- SPRITE DATA (LEFT FACING BOY) ---
1010 DATA 0,24,0, 0,24,0, 0,126,0
1020 DATA 0,255,0, 0,255,0, 0,126,0
1030 DATA 0,60,0, 0,36,0, 0,36,0
1040 DATA 0,36,0, 0,0,0, 0,0,0, 0 : REM PADDING
1050 FOR K=1 TO 53 : DATA 0 : NEXT K
